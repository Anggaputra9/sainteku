APP_NAME=Sainteku
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

# ── Database ────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sainteku
DB_USERNAME=root
DB_PASSWORD=

# ── WhatsApp / Whatsar ──────────────────────────
WHATSAPP_DRIVER=whatsar
WHATSAPP_ENABLED=true
WHATSAR_URL=http://127.0.0.1:8080
WHATSAR_API_KEY=
WHATSAR_DATA_DIR=
WHATSAR_DEFAULT_SESSION=
WHATSAR_TIMEOUT=30

# Whatsar process (dibaca binary + systemd EnvironmentFile)
WHATSAR_HOST=127.0.0.1
WHATSAR_PORT=8080
WHATSAR_DB_PATH=
WHATSAR_ADMIN_PASSWORD=
WHATSAR_MAX_SESSIONS=5

# Legacy Fonnte (rollback sementara)
# FONNTE_TOKEN=